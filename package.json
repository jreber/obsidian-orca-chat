{
	"name": "obsidian-orca-chat",
	"version": "0.1.0",
	"private": true,
	"description": "Chat with a local Orca-managed agent session from inside Obsidian.",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
