		"@types/jsdom": "^30.0.0",
		"@types/node": "^20.14.0",
		"@types/ws": "^8.18.1",
		"esbuild": "^0.21.5",
		"jsdom": "^30.1.0",
		"obsidian": "^1.5.7",
		"typescript": "^5.5.3"
	}
}
